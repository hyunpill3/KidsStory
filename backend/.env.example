# App
ENVIRONMENT=local
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Spring Boot's standard datasource properties; docker-compose
# overrides these to point at the "postgres" service)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kidsstory
SPRING_DATASOURCE_USERNAME=kidsstory
SPRING_DATASOURCE_PASSWORD=kidsstory

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Storage (local disk for dev; switch to "r2" in production)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_URL=http://localhost:8000/media

# Cloudflare R2 (S3-compatible object storage for photos/videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kidsstory
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.kidsstory.example.com

# Anonymous MVP: no accounts. Identity is a cookie; abuse prevention is IP + cookie based.
ANON_COOKIE_NAME=ks_anon_id
ANON_COOKIE_MAX_AGE_DAYS=30
MAX_PHOTOS_FREE=1
MAX_VIDEO_LENGTH_FREE=10
FREE_DAILY_PROJECT_LIMIT=1
WATERMARK_TEXT=KidsStory
# Blank = auto-detect (Windows: bundled Arial; Linux: fonts-dejavu-core).
# Override only if ffmpeg's drawtext filter can't find a usable font on
# your machine, e.g. WATERMARK_FONT_PATH=C:/Windows/Fonts/arial.ttf
WATERMARK_FONT_PATH=
MAX_UPLOAD_BYTES=8388608
PROJECT_TTL_HOURS=24

# How often the scheduled cleanup task purges expired (free-tier) projects.
CLEANUP_INTERVAL_MINUTES=60

# Cloudflare Turnstile (CAPTCHA). Leave blank to skip verification in dev.
TURNSTILE_SECRET_KEY=

# Replicate API token (https://replicate.com/account/api-tokens). Powers
# real image-to-video generation in SceneRenderingService.
VIDEO_GEN_API_KEY=
# Model ref for image+prompt -> video. $0.05/sec, so a 10s clip is $0.50.
VIDEO_GEN_MODEL=kwaivgi/kling-v1.6-standard
